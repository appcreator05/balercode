{
	"appId": "com.plexapp.android",
	"appName": "Movie App",
	"webDir": "dist",
	"overrideUserAgent": "Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"Fullscreen": {
			"activateOnLoad": true
		},
		"StatusBar": {
			"overlaysWebView": true
		},
		"SplashScreen": {
			"launchShowDuration": 2500,
			"launchAutoHide": true,
			"launchFadeOutDuration": 400,
			"backgroundColor": "#000000",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false,
			"splashFullScreen": true,
			"splashImmersive": true
		}
	}
}
